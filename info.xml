<?xml version="1.0"?>
<extension key="org.chabadrichmond.payarcjs" type="module">
  <file>payarcjs</file>
  <name>PayArc Hosted Fields</name>
  <description>Tokenized PayArc card payments for CiviCRM using PayArc Hosted Fields and the PayArc API, with CiviCRM-managed recurring gifts, refunds and Apple Pay / Google Pay.</description>
  <urls>
    <url desc="Main Extension Page">https://github.com/netzih/payarcjs</url>
    <url desc="Support">https://github.com/netzih/payarcjs/issues</url>
    <url desc="PayArc API documentation">https://docs.payarc.net/</url>
  </urls>
  <license>AGPL-3.0</license>
  <authors>
    <author>
      <name>Chabad Richmond</name>
      <role>Maintainer</role>
    </author>
  </authors>
  <releaseDate>2026-09-24</releaseDate>
  <version>0.1.0</version>
  <develStage>alpha</develStage>
  <compatibility>
    <ver>6.18</ver>
  </compatibility>
  <requires>
    <ext>civi_contribute</ext>
    <ext>mjwshared</ext>
  </requires>
  <classloader>
    <psr0 prefix="CRM_" path="."/>
  </classloader>
  <mixins>
    <mixin>mgd-php@2.0.0</mixin>
    <mixin>setting-php@1.0.0</mixin>
    <mixin>setting-admin@1.1.1</mixin>
  </mixins>
</extension>
